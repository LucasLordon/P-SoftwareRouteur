@model ParentDashboardViewModel
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Page_Title"].Value;
    Layout = "_LayoutParent";
}

<div class="sh-page-header">
    <div>
        <h1 class="sh-page-title">@Localizer["Page_Title"]</h1>
        <p class="sh-page-subtitle">@Localizer["Page_Subtitle"]</p>
    </div>
</div>

<div class="sh-stats-grid" style="grid-template-columns: repeat(3, 1fr);">
    <div class="sh-stat-card">
        <div class="sh-stat-header">
            <i class="bi bi-people"></i>
            <span>@Localizer["Stats_Children"]</span>
        </div>
        <div class="sh-stat-value">@Model.ChildProfiles.Count</div>
    </div>
    <div class="sh-stat-card">
        <div class="sh-stat-header">
            <i class="bi bi-trophy"></i>
            <span>@Localizer["Stats_Challenges"]</span>
        </div>
        <div class="sh-stat-value">0</div>
    </div>
    <div class="sh-stat-card">
        <div class="sh-stat-header">
            <i class="bi bi-wifi"></i>
            <span>@Localizer["Stats_Online"]</span>
        </div>
        <div class="sh-stat-value">0</div>
    </div>
</div>

<div class="sh-card">
    <div class="sh-card-header">
        <h2 class="sh-card-title">@Localizer["Table_Title"]</h2>
    </div>

    @if (Model.ChildProfiles.Any())
    {
        <table class="sh-table">
            <thead>
            <tr>
                <th>@Localizer["Col_Name"]</th>
                <th>@Localizer["Col_Role"]</th>
                <th>@Localizer["Col_Pin"]</th>
                <th>@Localizer["Col_Devices"]</th>
                <th class="sh-col-actions">@Localizer["Col_Actions"]</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.ChildProfiles)
            {
                <tr>
                    <td>@item.Profile.DisplayName</td>
                    <td><span class="sh-badge sh-badge-child">@Localizer["Badge_Child"]</span></td>
                    <td>
                        @if (item.Profile.PinHash != null)
                        {
                            <span class="sh-badge sh-badge-allow">@Localizer["Pin_Active"]</span>
                        }
                        else
                        {
                            <span class="sh-badge sh-badge-offline">@Localizer["Pin_Inactive"]</span>
                        }
                    </td>
                    <td>@item.DeviceCount</td>
                    <td class="sh-col-actions">
                        <button class="sh-action-btn" title="@Localizer["Tooltip_Edit"]"
                                onclick="openEditProfilModal(@item.Profile.Id, '@Html.Raw(item.Profile.DisplayName.Replace("'","\\\'"))')">
                            <i class="bi bi-pencil"></i>
                        </button>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
    else
    {
        <div class="sh-empty">
            <i class="bi bi-people"></i>
            <p>@Localizer["Empty"]</p>
        </div>
    }
</div>

<!-- Edit Profile Modal -->
<div class="sh-modal-backdrop" id="editProfilModal" onclick="if(event.target===this) this.classList.remove('show')">
    <div class="sh-modal">
        <div class="sh-modal-header">
            <h3 class="sh-modal-title">@Localizer["Modal_Edit_Title"]</h3>
            <button class="sh-modal-close" onclick="document.getElementById('editProfilModal').classList.remove('show')">&times;</button>
        </div>
        <form method="post" id="editProfilForm" action="">
            @Html.AntiForgeryToken()
            <div class="sh-modal-body">
                <div class="sh-form-group">
                    <label class="sh-form-label">@Localizer["Field_Name"]</label>
                    <input type="text" name="displayName" id="editProfilName" class="sh-input" required maxlength="100"/>
                </div>
                <div class="sh-form-group">
                    <label class="sh-form-label">@Localizer["Field_NewPin"]</label>
                    <input type="password" name="newPin" id="editProfilPin" class="sh-input" maxlength="4" pattern="\d{4}" autocomplete="new-password"/>
                    <small class="sh-form-hint">@Localizer["Pin_Optional"]</small>
                </div>
                <div class="sh-form-group">
                    <label class="sh-form-label">@Localizer["Field_ConfirmPin"]</label>
                    <input type="password" name="confirmPin" id="editProfilConfirmPin" class="sh-input" maxlength="4" pattern="\d{4}" autocomplete="new-password"/>
                </div>
            </div>
            <div class="sh-modal-footer">
                <button type="button" class="sh-btn-cancel"
                        onclick="document.getElementById('editProfilModal').classList.remove('show')">@Localizer["Btn_Cancel"]</button>
                <button type="submit" class="sh-btn-submit">
                    <i class="bi bi-check-lg"></i> @Localizer["Btn_Save"]
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openEditProfilModal(id, displayName) {
            document.getElementById('editProfilForm').action = '/parent/profils/edit/' + id;
            document.getElementById('editProfilName').value = displayName;
            document.getElementById('editProfilPin').value = '';
            document.getElementById('editProfilConfirmPin').value = '';
            document.getElementById('editProfilModal').classList.add('show');
        }
    </script>
}
